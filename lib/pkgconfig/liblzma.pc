prefix=/mnt/ceph/mjain/software/envs/bio
exec_prefix=/mnt/ceph/mjain/software/envs/bio
libdir=/mnt/ceph/mjain/software/envs/bio/lib
includedir=/mnt/ceph/mjain/software/envs/bio/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.8.2
Cflags: -I${includedir}
Cflags.private: -DLZMA_API_STATIC
Libs: -L${libdir} -llzma
Libs.private: -pthread -lpthread 
